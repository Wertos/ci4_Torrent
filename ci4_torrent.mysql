INSERT INTO `torrents` (`id`, `owner`, `infohash_v1`, `infohash_v2`, `numfiles`, `size`, `type`, `name`, `descr`, `category`, `created_at`, `updated_at`, `deleted_at`, `poster`, `magnet`, `url`, `file`, `comments`, `can_comment`, `modded`, `views`, `downloaded`, `file_name`, `version`, `seed`, `leech`, `completed`, `updated_peer`) VALUES
(1, 1, 0x4c50ef639f2f7ddae13fe09f645cfaa7482dd7cf, NULL, 2, 1576688777, 0, ' Лакомый кусок / The Rip (Джо Карнахан / Joe Carnahan) [2026, США, Боевик, детектив, триллер, WEB-DLRip] Dub (Red Head Sound)', '[b]Страна[/b]: США, Netflix\r\n[b]Жанр[/b]: Боевик, детектив, триллер\r\n[b]Год выпуска[/b]: 2026\r\n[b]Продолжительность[/b]: 01:55:00\r\n[b]Перевод[/b]: Профессиональный (псевдодублированный) Red Head Sound\r\n[b]Субтитры[/b]: русские (fors)\r\n\r\n[b]Режиссер[/b]: Джо Карнахан / Joe Carnahan\r\n\r\n[b]В ролях[/b]: Мэтт Дэймон, Бен Аффлек, Стивен Ян, Кайл Чандлер, Скотт Эдкинс, Каталина Сандино Морено, Нестор Карбонелл, Хосе Пабло Кантилло, Тейана Тейлор, Саша Калле, Лина Эско, Дайсукэ Таудзи, Иван Амаро Баллон, Элли Морено, Майкл Шон, Крис Сильвестри, Дэйв Ферринр, Чирил Пауланн\r\n\r\n[b]Описание[/b]: Майами. Убита сотрудница опергруппы отдела по борьбе с наркотиками. ФБР допрашивает её коллег, полагая, что кто-то из них может быть причастен к убийству. Тем же вечером опергруппа по наводке отправляется в пригородный дом, где могут быть спрятаны деньги наркокартеля, но на месте вместо нескольких сотен тысяч обнаруживается гораздо большая сумма. Напряжение нарастает, оперативникам начинают поступать звонки с угрозами, и, кажется, среди них притаился предатель.\r\n\r\n[b]Качество видео[/b]: WEB-DLRip\r\n[b]Формат видео[/b]: AVI\r\n\r\n[b]Видео[/b]: 720x304 (2.35:1), 24.000 fps, XviD, ~1379 kbps avg, 0.26 bit/pixel\r\n[b]Аудио[/b]: 48 kHz, AC3 Dolby Digital, 3/2 (L,C,R,l,r) + LFE ch, ~448 kbps - rus\r\n\r\n[spoiler][URL=https://imageban.ru/show/2026/01/31/d77a44e673f55cdf050ddec8a9996008/png][IMG]https://i8.imageban.ru/thumbs/2026.01.31/d77a44e673f55cdf050ddec8a9996008.png[/IMG][/URL][URL=https://imageban.ru/show/2026/01/31/1d2278a3069a0b921428e73cda5b79f4/png][IMG]https://i7.imageban.ru/thumbs/2026.01.31/1d2278a3069a0b921428e73cda5b79f4.png[/IMG][/URL][URL=https://imageban.ru/show/2026/01/31/9f60895dffd420395b8e4ef38ca2c9a2/png][IMG]https://i5.imageban.ru/thumbs/2