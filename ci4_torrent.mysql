(20, 1, 0x9d95c5932576a1bd79b5f077b9847a1f60d10de4, NULL, 10, 11113713048, 0, 'Первый отдел [05х01-10 из 20] (2025) WEB-DL 1080p от ExKinoRay', '[b]Название[/b]: Первый отдел\r\n[b]Год выхода[/b]: 2025\r\n[b]Жанр[/b]: Детектив\r\n[b]Режиссер[/b]: Михаил Вассербаум, Максим Бриус\r\n[b]В ролях[/b]: Иван Колесников, Сергей Жарков, Елена Вожакина, Сергей Комаров (II), Олег Андреев, Владимир Литвинов, Олег Попов (II), Александр Разбаш, Николай Горшков, Виталий Бисеров, Маруся Иванова, Иван Васильев, Евгения Шахнович, Михаил Лучко, Марк Горонок, Алексей Особенков, Евгений Михайленко, Елена Донина, Даниил Воронин, Сергей Колосовский, Василий Данько, Мария Скуратова (II), Михаил Новиков, Никита Береснев, Валентина Иккерт, Виталий Ковалёв, Владислав Третьяк (II), Маргарита Калекина, Алиса Каримова, Анастасия Курылёва, Артур Панов, Роман Никитин, Даниил Слуцкий\r\n\r\n[b]О фильме[/b]: В финале четвёртого сезона давний недруг Брагина Гаспаров обвиняет Веру Брагину в преступлении 20-летней давности и отправляет под стражу. В новых сериях уголовное дело в отношении супруги главного героя прекращается, однако личность убийцы по-прежнему не установлена, поэтому расследование продолжается. Тем временем Брагин решает вернуться к работе и намерен восстановиться в прежней должности в Следственном Комитете России, вот только его место уже занято. В результате Брагин становится обычным следователем в одном из районов Петербурга, где ему, в частности, предстоит заниматься расследованием преступлений прошлых лет. На новом месте службы главный герой узнаёт, что коллега, который занимал эту должность до него, не уволился, как полагал Брагин, а бесследно исчез. В какой-то момент Брагин понимает, что исчезновение следователя как-то связано с одним из тех дел, которыми он теперь занимается. Вот только как?\r\n\r\n[b]Страна[/b]: Россия\r\n[b]Студия[/b]: Кинокомпания «Триикс Медиа»\r\n[b]Продолжительность[/b]: 10 x ~ 00:48:00\r\n[b]Перевод[/b]: Не требуется\r\n\r\n[b]Формат[/b]: MKV\r\n[b]Качество[/b]: WEB-DL 1080p\r\n[b]Видео[/b]: MPEG-4 AVC, ~ 2700 Кбит/с, 1920х1080, 25 кадр/с\r\n[b]Звук[/b]: Русский, АAC, 2 ch, 256 Кбит/с  RUS\r\n\r\n[spoiler][URL=https://imageban.ru/show/2026/02/16/9249684be1780f76b3dfeb3321fa3192/jpg][IMG]https://i4.imageban.ru/thumbs/2026.02.16/9249684be1780f76b3dfeb3321fa3192.jpg[/IMG][/URL][URL=https://imageban.ru/show/2026/02/16/fbf302e2ce4b7b8f46d16e871bdcdcfc/jpg][IMG]https://i1.imageban.ru/thumbs/2026.02.16/fbf302e2ce4b7b8f46d16e871bdcdcfc.jpg[/IMG][/URL][URL=https://imageban.ru/show/2026/02/16/ba387c1f19bad36a5f7eea31b3cddf60/jpg][IMG]https://i1.imageban.ru/thumbs/2026.02.16/ba387c1f19bad36a5f7eea31b3cddf60.jpg[/IMG][/URL][URL=https://imageban.ru/show/2026/02/16/3f629f73ec80ec10a7822ef6de7ad7c3/jpg][IMG]https://i2.imageban.ru/thumbs/2026.02.16/3f629f73ec80ec10a7822ef6de7ad7c3.jpg[/IMG][/URL][/spoiler]', 4, '2026-02-21 11:26:20', NULL, NULL, 'https://i114.fastpic.ru/big/2020/1117/39/64d95e9324a2aecbb0836e5f44e1c939.jpg', 'magnet:?xt=urn:btih:9d95c5932576a1bd79b5f077b9847a1f60d10de4&dn=Pervyi.otdel.S05.2025.WEB-DL.1080p.ExKinoRay&tr=udp%3A%2F%2Fopentor.net%3A6969&tr=udp%3A%2F%2Ftracker.openbittorrent.com%3A80%2Fannounce&tr=udp%3A%2F%2Ftracker.publicbt.com%3A80%2Fannounce&tr=http%3A%2F%2Fretracker.local%2Fannounce&tr=http%3A%2F%2Ftracker.grepler.com%3A6969%2Fannounce&tr=udp%3A%2F%2Ftracker.dler.com%3A6969%2Fannounce&tr=http%3A%2F%2Fh4.trakx.nibba.trade%3A80%2Fannounce&tr=udp%3A%2F%2Fopen.stealth.si%3A80%2Fannounce&tr=udp%3A%2F%2Ftracker.bitsearch.to%3A1337%2Fannounce&tr=udp%3A%2F%2Fexodus.desync.com%3A6969%2Fannounce', 'pervyj-otdel-05h01-10-iz-20-2025-web-dl-1080p-ot-exkinoray', 1, 0, 1, 1, 2, 0, '1771662380_a7b9bfcf0b1f7c55c907.torrent', 1, 162, 364, 452, '2026-02-21 11:26:39'),
(21, 1, 0xfa64f7f2bfba35a4fc20f41319d86e375590409e, NULL, 16, 15665111337, 0, 'Госзащита [S01] (2025) WEB-DL 1080p от Files-x', '[b]Название[/b]: Госзащита\r\n[b]Год выпуска[/b]: 2025\r\n[b]Жанр[/b]: Комедия\r\n[b]Режиссер[/b]: Андрей Шавкеро\r\n[b]В ролях[/b]: Владимир Сычёв, Елизавета Бугулова, Зоя Бербер, Денис Власенко, Александрина Олексюк, Григорий Калинин, Александр Половцев, Никита Плащевский, Евдокия Федулова, Александр Тютин, Ренат Мухамбаев, Александра Власова, Андрей Курносов, Елена Муравьёва\r\n\r\n[b]О фильме[/b]: Бизнесмен Роман Соколов и его партнёр попадают в руки правоохранительных органов по подозрению в мошенничестве в особо крупном размере. Однако Роман заранее заключил сделку со следствием: в результате его сообщника отправляют в СИЗО, а его самого вместе с дочерью Алисой по программе защиты свидетелей перевозят в Благовещенск. Теперь они - \"семья Хомяковых\", а их безопасность обеспечивают майор Света и капитан Гриша. Роману предстоит играть роль примерного семьянина, жить в \"липовой\" полицейской семье и налаживать отношения с дочерью Алисой, которая совсем не рада переезду.\r\n\r\n[b]Выпущено[/b]: Россия\r\n[b]Студия[/b]: ТНТ, 1-2-3 Production, Инсайт люди\r\n[b]Продолжительность[/b]: 16 x ~ 00:22:10\r\n[b]Перевод[/b]: Не требуется\r\n\r\n[b]Качество[/b]: WEB-DL 1080p\r\n[b]Видео[/b]:MPEG-4 AVC, ~ 6000 Кбит/с, 1920x1080\r\n[b]Аудио[/b]:Русский (AAC, 2 ch, 192 Кбит/с)\r\n\r\n[spoiler][URL=https://fastpic.org/view/127/2026/0209/_dc6fa5de8574e82077cbb2f5c85b53ed.png.html][IMG]https://i127.fastpic.org/thumb/2026/0209/ed/_dc6fa5de8574e82077cbb2f5c85b53ed.jpeg[/IMG][/URL][URL=https://fastpic.org/view/127/2026/0209/_28fb487f28f4d528c0bc5e24f58be3a4.png.html][IMG]https://i127.fastpic.org/thumb/2026/0209/a4/_28fb487f28f4d528c0bc5e24f58be3a4.jpeg[/IMG][/URL][URL=https://fastpic.org/view/127/2026/0209/_bad915e684e21ace30a27618a13cd976.png.html][IMG]https://i127.fastpic.org/thumb/2026/0209/76/_bad915e684e21ace30a27618a13cd976.jpeg[/IMG][/URL][URL=http